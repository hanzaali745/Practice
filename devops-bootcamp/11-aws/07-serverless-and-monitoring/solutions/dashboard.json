{
  "widgets": [
    {
      "type": "metric", "x": 0, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "demo-app errors (from logs)", "region": "eu-west-1", "stat": "Sum", "period": 60,
        "metrics": [["DemoApp", "Errors"]]
      }
    },
    {
      "type": "metric", "x": 12, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "ECS service CPU % (Module 06)", "region": "eu-west-1", "stat": "Average", "period": 60,
        "metrics": [["AWS/ECS", "CPUUtilization", "ClusterName", "demo", "ServiceName", "demo-app"]]
      }
    },
    {
      "type": "log", "x": 0, "y": 6, "width": 24, "height": 6,
      "properties": {
        "title": "Latest errors", "region": "eu-west-1",
        "query": "SOURCE '/demo/app' | fields @timestamp, message | filter log.level = \"error\" | sort @timestamp desc | limit 20"
      }
    }
  ]
}
