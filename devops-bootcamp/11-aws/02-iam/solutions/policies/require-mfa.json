{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyEverythingWithoutMFAExceptSettingItUp",
      "Effect": "Deny",
      "NotAction": ["iam:CreateVirtualMFADevice", "iam:EnableMFADevice", "iam:ListMFADevices",
                    "iam:GetUser", "iam:ChangePassword", "sts:GetSessionToken"],
      "Resource": "*",
      "Condition": {"BoolIfExists": {"aws:MultiFactorAuthPresent": "false"}}
    }
  ]
}
