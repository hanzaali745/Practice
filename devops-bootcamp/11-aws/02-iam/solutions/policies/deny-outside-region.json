{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StayInOneRegion",
      "Effect": "Deny",
      "NotAction": ["iam:*", "sts:*", "organizations:*", "budgets:*", "cloudfront:*", "route53:*", "support:*"],
      "Resource": "*",
      "Condition": {"StringNotEquals": {"aws:RequestedRegion": "eu-west-1"}}
    }
  ]
}
