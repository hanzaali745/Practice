{
  "index_patterns": ["demo-logs-*"],
  "template": {
    "settings": {"number_of_shards": 1, "number_of_replicas": 0},
    "mappings": {
      "properties": {
        "@timestamp": {"type": "date"},
        "message": {"type": "text"},
        "log": {"properties": {"level": {"type": "keyword"}}},
        "service": {"properties": {"name": {"type": "keyword"}, "version": {"type": "keyword"}}},
        "host": {"properties": {"name": {"type": "keyword"}}},
        "container": {"properties": {"name": {"type": "keyword"}}},
        "url": {"properties": {"path": {"type": "keyword"}, "original": {"type": "keyword"}}},
        "http": {"properties": {
          "request": {"properties": {"method": {"type": "keyword"}, "referrer": {"type": "keyword"}}},
          "response": {"properties": {"status_code": {"type": "short"}, "body": {"properties": {"bytes": {"type": "long"}}}}},
          "version": {"type": "keyword"}}},
        "event": {"properties": {"duration": {"type": "long"}}},
        "client": {"properties": {"ip": {"type": "ip"}}},
        "user_agent": {"properties": {"original": {"type": "keyword"}}}
      }
    }
  }
}
