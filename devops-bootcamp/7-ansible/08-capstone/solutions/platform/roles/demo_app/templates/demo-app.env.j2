# {{ ansible_managed }}
APP_MESSAGE="{{ demo_app_message | replace('"', '\\"') }}"
APP_VERSION="{{ demo_app_version }}"
{% if demo_app_redis_host %}
REDIS_HOST="{{ demo_app_redis_host }}"
REDIS_PORT="{{ demo_app_redis_port }}"
REDIS_PASSWORD="{{ demo_app_redis_password | replace('"', '\\"') }}"
{% endif %}
{% for key, value in demo_app_extra_env | dictsort %}
{{ key }}="{{ value | string | replace('"', '\\"') }}"
{% endfor %}
