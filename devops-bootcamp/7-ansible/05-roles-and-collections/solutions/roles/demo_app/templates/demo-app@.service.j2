# {{ ansible_managed }}
[Unit]
Description=demo-app instance on port %i
After=network.target

[Service]
User={{ demo_app_user }}
Group={{ demo_app_user }}
Environment=PORT=%i
EnvironmentFile=/etc/demo-app/demo-app.env
ExecStart=/usr/bin/python3 {{ demo_app_dir }}/app.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
