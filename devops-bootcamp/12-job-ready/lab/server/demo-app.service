[Unit]
Description=demo-app (the service users depend on)
After=network-online.target

[Service]
User=demo
Group=demo
WorkingDirectory=/opt/demo-app
Environment=PORT=8000 APP_VERSION=1.0.0 LOG_FORMAT=json REDIS_HOST=redis
ExecStart=/usr/bin/python3 /opt/demo-app/app.py
# the app logs to stdout (→ journald); ops also keeps a copy on disk for the log shipper
StandardOutput=append:/var/log/demo-app/app.log
StandardError=journal
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
