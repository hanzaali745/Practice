#!/bin/sh
# pre-commit — refuse commits that contain secrets or huge files. Install in a repo:
#   cp pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# (Teams share hooks with the pre-commit framework instead — see ../.pre-commit-config.yaml.)
# Skip once, deliberately: git commit --no-verify
max_kb=1024
status=0

# only what is being committed (added, copied, modified), not the whole working tree
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

for f in $files; do
    case $f in
        .env|*/.env|*.pem|*.key|id_rsa|id_ed25519)
            echo "🔒 $f looks like a secret file — add it to .gitignore"; status=1 ;;
    esac
    size_kb=$(( $(git cat-file -s ":$f") / 1024 ))
    if [ "$size_kb" -gt "$max_kb" ]; then
        echo "🐘 $f is ${size_kb} KB (limit ${max_kb} KB) — use Git LFS or keep it out of Git"; status=1
    fi
done

# scan the ADDED lines of the staged diff for well-known secret patterns
if git diff --cached -U0 --diff-filter=ACM | grep '^+' | grep -nE \
    'AKIA[0-9A-Z]{16}|aws_secret_access_key|-----BEGIN [A-Z ]*PRIVATE KEY-----|ghp_[0-9A-Za-z]{36}|xox[baprs]-[0-9A-Za-z-]+' ; then
    echo "🔒 the lines above look like credentials — use environment variables or a secret manager"; status=1
fi

[ "$status" -eq 0 ] || echo "❌ commit blocked by .git/hooks/pre-commit"
exit $status
